1d:["$","details",null,{"className":"evidence-description","children":[["$","summary",null,{"children":"Map description and source credits"}],["$","p",null,{"children":"Dark red areas show designated critical habitat over a beige land and pale blue water basemap. Highlighted areas appear along part of Lake Okeechobee, inland wetlands west of the southeastern coastal cities, and smaller inland patches farther north. Unshaded areas do not establish that the species is absent or that habitat is unsuitable."}],["$","p",null,{"children":["Critical habitat data: U.S. Fish and Wildlife Service, shared by Esri_US_Federal_Data under ",["$","a",null,{"href":"https://creativecommons.org/licenses/by/4.0/","target":"_blank","rel":"noreferrer","children":"Creative Commons Attribution 4.0"}],", filtered to the Everglade snail kite. Basemap credits printed in the image include Esri, TomTom, Garmin, FAO, NOAA, USGS, OpenStreetMap contributors, the GIS User Community, and CGIAR. ",["$","a",null,{"href":"/evidence/snail-kite-evidence-notes.txt","children":"Read the complete evidence and attribution notes"}],"."]}]]}]

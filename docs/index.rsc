1:[[["$","link","css:/_next/static/css/page.DprLdne8.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/page.DprLdne8.css","data-rsc-css-href":"/_next/static/css/page.DprLdne8.css"}],["$","link","css:/_next/static/css/index.DxO75b9s.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/index.DxO75b9s.css","data-rsc-css-href":"/_next/static/css/index.DxO75b9s.css"}],"$undefined"],[["$","a",null,{"className":"skip-link","href":"#main","children":"Skip to main content"}],["$","header",null,{"className":"header wrap","children":[["$","a",null,{"href":"#home","className":"identity","aria-label":"Cole Jorgensen home","children":[["$","span",null,{"className":"monogram","children":["CJ",["$","span",null,{"children":"↗"}]]}],["$","span",null,{"children":"Cole Jorgensen"}]]}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"#home","children":"Home"}],["$","a",null,{"href":"#work","children":"Projects"}],["$","a",null,{"href":"#about","children":"About"}],["$","a",null,{"href":"#connect","children":"Connect"}]]}]]}],["$","main",null,{"id":"main","children":[["$","section",null,{"id":"home","className":"intro wrap","aria-labelledby":"intro-title","children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{"className":"dot"}]," GIS · APPLICATIONS · STORYTELLING"]}],["$","h1",null,{"id":"intro-title","children":["A sense of place.",["$","br",null,{}],["$","span",null,{"children":"A world of possibility."}]]}],["$","div",null,{"className":"intro-bottom","children":[["$","p",null,{"children":"I’m Cole Jorgensen. I use maps, data, and software to explore places and build useful tools."}],["$","a",null,{"className":"work-link","href":"#work","children":["Explore my work ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v14","key":"s699le"}],["path",{"d":"m19 12-7 7-7-7","key":"1idqje"}]],"className":"lucide-arrow-down","size":20}]]}]]}]]}],["$","section",null,{"id":"work","className":"work wrap","aria-labelledby":"work-title","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"work-title","children":"Projects"}],["$","span",null,{"children":"04 / SELECTED WORK"}]]}],["$","p",null,{"className":"gallery-intro","children":"Choose a cover to explore the story, evidence, and tools behind each project."}],["$","div",null,{"className":"project-gallery","children":[["$","$Le",null,{"id":"terrain","number":"01","category":"GIS / URBAN PLANNING","title":"Knoxville’s Urban Growth Based on Terrain","description":"An individual Spring 2026 GEOG 454 project combining terrain and planning factors to investigate housing suitability.","cover":"/evidence/knoxville-housing-suitability.png","coverAlt":"Knoxville housing suitability map with a green and red model surface, roads, and the city boundary.","coverWidth":2400,"coverHeight":1500,"tags":["ArcGIS Pro","Terrain analysis","Suitability modeling"],"children":[["$","div",null,{"className":"professional-story","children":[["$","section",null,{"aria-labelledby":"terrain-context","children":[["$","h4",null,{"id":"terrain-context","children":"Context and purpose"}],["$","p",null,{"children":"Knoxville’s terrain creates opportunities and constraints for housing growth. For my individual Spring 2026 GEOG 454 GIS for Terrain Analysis project, I investigated how terrain, accessibility, environmental constraints, land cover, and zoning could identify relatively suitable housing areas. My goal was to explain a spatial model to a planning audience."}]]}],["$","section",null,{"aria-labelledby":"terrain-role","children":[["$","h4",null,{"id":"terrain-role","children":"My role"}],["$","p",null,{"children":"I carried out the GIS analysis, developed the maps, and organized the results into an ArcGIS StoryMap. I used agency datasets credited below; my contribution was combining, analyzing, and communicating them."}]]}],["$","section",null,{"aria-labelledby":"terrain-methods","children":[["$","h4",null,{"id":"terrain-methods","children":"Methods and tools"}],["$","p",null,{"children":"In ArcGIS Pro, I aligned coordinate systems, clipped datasets to the study area, derived slope from elevation, and calculated distance to roads, water, and buildings. I reclassified factors onto a common 1–5 suitability scale and combined them using weighted overlay. Slope received the greatest emphasis, followed by road access and proximity to existing development. Gentle slopes of 0–5 degrees received high suitability."}]]}],"$Lf","$L10"]}],"$L11","$L12"]}],"$L13","$L14","$L15"]}],"$L16"]}],"$L17","$L18"]}],"$L19"]]
f:["$","section",null,{"aria-labelledby":"terrain-results","children":[["$","h4",null,{"id":"terrain-results","children":"Results and limits"}],["$","p",null,{"children":"I produced four web maps and a published StoryMap. Higher modeled suitability occurs where gentle terrain, access, suitable land cover and zoning, and fewer environmental constraints coincide. The final map below preserves that result. It describes relative suitability under my assumptions; ownership, costs, utilities, demand, and future zoning require further investigation before a planning decision."}]]}]
10:["$","section",null,{"aria-labelledby":"terrain-reflection","children":[["$","h4",null,{"id":"terrain-reflection","children":"Reflection"}],["$","p",null,{"children":"I learned that a suitability map reflects choices about factors, scores, and weights. Explaining those choices is part of making the analysis useful. This project connected my GIS skills with planning and public communication. My next step is to document the exact scores and weights and compare alternatives to assess how sensitive the results are."}]]}]
11:["$","figure",null,{"className":"terrain-evidence","aria-labelledby":"terrain-evidence-title","children":[["$","h4",null,{"id":"terrain-evidence-title","children":"Evidence · Final housing suitability map"}],["$","p",null,{"children":"This static export preserves the final model as evidence on my personal portfolio. It can be viewed here without signing into ArcGIS."}],["$","a",null,{"href":"/evidence/knoxville-housing-suitability.png","target":"_blank","rel":"noreferrer","aria-label":"Open the full-resolution Knoxville housing suitability map","children":["$","img",null,{"src":"/evidence/knoxville-housing-suitability.png","alt":"Knoxville housing suitability model with roads and the city boundary. Green indicates higher relative suitability and red lower suitability. A detailed text description follows.","width":2400,"height":1500,"loading":"lazy"}]}],["$","div",null,{"className":"map-legend","aria-label":"Relative modeled suitability, lower to higher","children":[["$","span",null,{"children":"Lower suitability"}],["$","span",null,{"className":"legend-ramp","aria-hidden":"true"}],["$","span",null,{"children":"Higher suitability"}]]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Knoxville housing suitability — final model."}]," Analysis and map by Cole Jorgensen, Spring 2026. This is a static rendering of my final web map, showing the modeled suitability layer, roads, and city boundary. It documents a course analysis and should be read with the limitations above."]}],["$","details",null,{"className":"evidence-description","children":[["$","summary",null,{"children":"Map description and source credits"}],["$","p",null,{"children":"The map shows the irregular Knoxville city boundary in black with a network of gray roads. Most of the displayed modeled area is green, with lower-suitability red areas in narrower patches, including along parts of the river corridor. The red-to-yellow-to-green ramp represents lower to higher modeled suitability; it is a continuous display, not a parcel approval or a forecast. White areas have no suitability surface shown in this export. The description provides a text equivalent without relying only on color."}],["$","p",null,{"children":["Project data sources credited in the original StoryMap: USGS 3DEP elevation; U.S. Census Bureau TIGER/Line roads and water; Microsoft Building Footprints; FEMA flood zones; Esri/USGS National Land Cover Database; City of Knoxville boundary; Knoxville–Knox County Planning zoning; and KGIS. Static rendering produced through Esri’s public map-printing service. ",["$","a",null,{"href":"/evidence/terrain-evidence-notes.txt","children":"Read the evidence and attribution notes"}],"."]}]]}],["$","div",null,{"className":"evidence-links","children":[["$","a",null,{"className":"text-link","href":"/evidence/knoxville-housing-suitability.png","download":true,"children":["Download map evidence ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:1:2:props:children:0:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-down","size":17}]]}],["$","a",null,{"className":"text-link","href":"https://storymaps.arcgis.com/stories/38c29a40909d4fcd8070e5e6805f54a2","target":"_blank","rel":"noreferrer","children":["Read the original StoryMap ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":17}]]}]]}],["$","p",null,{"className":"project-note","children":"The original interactive StoryMap is hosted through UTK ArcGIS. The map image and explanation on this page are stored separately in my personal GitHub repository."}]]}]
12:["$","p",null,{"className":"project-note","children":[["$","strong",null,{"children":"Next evidence:"}]," A workflow excerpt explaining the factor scores and weighting decisions."]}]
13:["$","$Le",null,{"id":"snail-kite","number":"02","category":"GEOVISUALIZATION / WILDLIFE","title":"The Everglade Snail Kite","description":"An individual Spring 2026 GEOG 311 StoryMap connecting a wildlife narrative with a species-focused critical-habitat map.","cover":"/evidence/snail-kite-critical-habitat.png","coverAlt":"Map of peninsular Florida with designated Everglade snail kite critical habitat highlighted in dark red.","coverWidth":2400,"coverHeight":1500,"tags":["ArcGIS StoryMaps","Web mapping","Geographic communication"],"children":[["$","p",null,{"className":"project-lead","children":"Giving an ecological story a geographic context."}],["$","div",null,{"className":"professional-story","children":[["$","section",null,{"aria-labelledby":"kite-context","children":[["$","h4",null,{"id":"kite-context","children":"Context and purpose"}],["$","p",null,{"children":"For my individual Spring 2026 GEOG 311 Geovisualization and Geographic Information Science project at the University of Tennessee, Knoxville, I created a StoryMap introducing the Everglade snail kite. I wanted to connect a wildlife narrative with a map locating designated critical habitat in Florida."}]]}],["$","section",null,{"aria-labelledby":"kite-role","children":[["$","h4",null,{"id":"kite-role","children":"My role"}],["$","p",null,{"children":"I composed the StoryMap, organized supporting information, and configured the species-focused web map. My contribution was geographic presentation and communication. Habitat boundaries came from the U.S. Fish and Wildlife Service; ecological information and photographs were credited to their original sources."}]]}],["$","section",null,{"aria-labelledby":"kite-methods","children":[["$","h4",null,{"id":"kite-methods","children":"Methods and tools"}],["$","p",null,{"children":"I used ArcGIS StoryMaps to combine narrative, attributed imagery, and an interactive map, drawing on information cited from USFWS and the Florida Fish and Wildlife Conservation Commission. In ArcGIS Map Viewer, I filtered the public USFWS Critical Habitat layer to the common name “Everglade snail kite.” I saved a focused view and embedded it with a legend so the mapped evidence directly supported the text."}]]}],["$","section",null,{"aria-labelledby":"kite-results","children":[["$","h4",null,{"id":"kite-results","children":"Results and limits"}],["$","p",null,{"children":"The result was a published StoryMap, first published April 1, 2026, and an accompanying interactive habitat map. The static map below preserves the geographic evidence independently of university access. The agency boundaries represent designated critical habitat; they do not show the complete species range, individual birds, or nests. This project did not produce new field observations or a population estimate."}]]}],["$","section",null,{"aria-labelledby":"kite-reflection","children":[["$","h4",null,{"id":"kite-reflection","children":"Reflection"}],["$","p",null,{"children":"I learned that narrative introduces a subject while a map places it geographically. Clear labels and source credits help readers distinguish my presentation work from the underlying agency data. This strengthened my interest in environmental communication. In future revisions, I would review the map description alongside the narrative to keep its scope and limitations clear."}]]}]]}],["$","figure",null,{"className":"terrain-evidence","aria-labelledby":"kite-evidence-title","children":[["$","h4",null,{"id":"kite-evidence-title","children":"Evidence · Designated critical habitat map"}],["$","p",null,{"children":"This personally hosted static rendering preserves the map evidence independently of my university ArcGIS account."}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}]
14:["$","$Le",null,{"id":"church-atlas-project","number":"03","category":"WEB MAPPING / PROTOTYPE","title":"Church Atlas","description":"A geographic search interface for exploring sample church listings, comparing profiles, and planning a visit.","cover":"/images/church-atlas-cover.jpg","coverAlt":"Church Atlas interface with location and denomination filters, a map of sample listings, and nearby church cards.","tags":["JavaScript","Leaflet","Web GIS","Interface design"],"children":["$","div",null,{"className":"prototype-overview","children":[["$","h4",null,{"children":"Exploring communities through location"}],["$","p",null,{"children":"Church Atlas combines an interactive map with structured filters to help visitors explore sample church listings. Users can search an area, adjust a geographic radius, filter by denomination and visit needs, compare profiles, and save favorites and a visit plan in their browser."}],["$","p",null,{"children":[["$","strong",null,{"children":"Skills demonstrated:"}]," Geographic filtering, organizing categorical data, JavaScript interface development, and building an interactive web map with Leaflet."]}],["$","a",null,{"className":"primary-link","href":"/church-atlas/","children":["Open Church Atlas demo ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$11:props:children:6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":19}]]}],["$","p",null,{"className":"project-note","children":"The prototype uses sample listings and illustrative source-status labels. Favorites and visit plans are stored locally in the browser."}],["$","h4",null,{"children":"Evidence and next steps"}],["$","p",null,{"children":"The cover screenshot shows the actual prototype’s filters, sample markers, search radius, and results. Interface by Cole Jorgensen; map rendered with Leaflet, © OpenStreetMap contributors. The application source is stored in my personal GitHub repository."}],["$","p",null,{"children":["$","a",null,{"className":"text-link","href":"/images/church-atlas-cover.jpg","target":"_blank","rel":"noreferrer","children":["View full screenshot ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$11:props:children:6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":17}]]}]}],["$","p",null,{"className":"project-note","children":[["$","strong",null,{"children":"Planned evidence:"}]," An annotated screenshot and short code excerpt explaining the distance and filtering logic."]}]]}]}]
15:["$","$Le",null,{"id":"jobfinder-project","number":"04","category":"PYTHON / PROTOTYPE","title":"JobFinder","description":"A location-aware job-search prototype with map exploration, search filters, and commute and job-fit information.","cover":"/images/jobfinder-cover.jpg","coverAlt":"JobFinder prototype map showing sample job markers and geographic search controls.","tags":["Python","Streamlit","GIS","Application development"],"children":["$","div",null,{"className":"prototype-overview","children":[["$","h4",null,{"children":"The job search, with location in focus"}],["$","p",null,{"children":"JobFinder is a Python and Streamlit prototype for exploring jobs on a map, narrowing results with filters, and comparing opportunities with commute and job-fit information."}],["$","p",null,{"children":[["$","strong",null,{"children":"Skills demonstrated:"}]," Python application development, location-based information design, and turning search criteria into an interactive workflow."]}],["$","a",null,{"className":"primary-link","href":"https://colejorgensen28-jobfinder-mvp-streamlit-app-y5bg8r.streamlit.app/","target":"_blank","rel":"noreferrer","children":["Open JobFinder demo ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$11:props:children:6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":19}]]}],["$","p",null,{"className":"project-note","children":"Prototype with demonstration data. Opens on Streamlit; the free demo may need to wake after inactivity."}],["$","h4",null,{"children":"Evidence and next steps"}],["$","p",null,{"children":"The cover screenshot records the running prototype’s map interface with sample job locations. The screenshot is stored on my personal portfolio so it remains viewable when the demo is asleep. Application by Cole Jorgensen; map attribution appears in the screenshot and includes CARTO and OpenStreetMap contributors."}],["$","p",null,{"children":["$","a",null,{"className":"text-link","href":"/images/jobfinder-cover.jpg","target":"_blank","rel":"noreferrer","children":["View full screenshot ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$11:props:children:6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":17}]]}]}],["$","p",null,{"className":"project-note","children":[["$","strong",null,{"children":"Planned evidence:"}]," An annotated explanation of the map and filters plus a focused code excerpt showing how location-based search works."]}]]}]}]
16:["$","section",null,{"className":"portfolio-plan","aria-labelledby":"portfolio-plan-title","children":[["$","h3",null,{"id":"portfolio-plan-title","children":"Building the complete portfolio"}],["$","p",null,{"children":"Four examples are available above. I’m developing a six-to-eight-example portfolio that shows GIS analysis, application development, and geographic communication."}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Develop the current examples:"}]," Expand Church Atlas and JobFinder into complete professional stories with annotated screenshots and focused code excerpts. Add the terrain model’s factor scores, weights, and a comparison of alternative weights."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Planned example 5 — GIS programming:"}]," Select a GEOG 312 programming artifact, explain the problem and my contribution, and include a short code excerpt with a sample input and output."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Planned example 6 — Remote sensing:"}]," Develop an example from the ongoing Hurricane Helene landscape-change project after checking my individual contribution and available results. Include an attributed workflow or map and distinguish completed analysis from proposed methods."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Possible examples 7–8:"}]," Select additional work only when it demonstrates a distinct skill and has shareable evidence. Each added example will include context, contribution, results, reflection, a caption, and a text description of visual evidence."]}]]}],["$","p",null,{"className":"project-note","children":"The planned examples are in development. A résumé download will be added to About after the résumé portion of the course."}]]}]
17:["$","section",null,{"id":"about","className":"about wrap","aria-labelledby":"about-title","children":[["$","div",null,{"className":"about-photo","children":["$","img",null,{"src":"/images/cole-jorgensen.jpeg","alt":"Cole Jorgensen wearing a dark suit and tie","width":3024,"height":4032,"loading":"lazy"}]}],["$","div",null,{"className":"about-copy","children":[["$","div",null,{"className":"eyebrow","children":"BEHIND THE PROJECTS"}],["$","h2",null,{"id":"about-title","children":"About me"}],["$","p",null,{"className":"about-lead","children":"I bring maps, data, and application development together to explore how people connect with places."}],["$","p",null,{"children":"My work spans GIS analysis, interactive storytelling, and practical web applications. Through terrain analysis, wildlife storytelling, Church Atlas, and JobFinder, I explore how location can support planning, explain environmental topics, and help people find communities and opportunities."}],["$","p",null,{"children":"I’m interested in GIS analysis and web mapping roles where I can turn spatial data into clear explanations and useful tools. This portfolio is intended for GIS employers, internship supervisors, and professionals working in planning and spatial application development."}],["$","div",null,{"className":"tags","children":[["$","span",null,{"children":"Geographic information systems"}],["$","span",null,{"children":"Web applications"}],["$","span",null,{"children":"Interactive storytelling"}]]}]]}],["$","div",null,{"className":"education","aria-labelledby":"education-title","children":[["$","h3",null,{"id":"education-title","children":"Education"}],["$","div",null,{"className":"education-grid","children":[["$","article",null,{"className":"education-entry","children":[["$","p",null,{"className":"education-date","children":"Expected May 2027"}],["$","h4",null,{"children":"University of Tennessee, Knoxville"}],["$","p",null,{"className":"education-degree","children":"Bachelor of Science in Geographic Information Science and Technology"}],["$","p",null,{"children":[["$","strong",null,{"children":"Relevant coursework:"}]," GEOG 311 Geovisualization and Geographic Information Science; GEOG 312 GIS Programming; GEOG 454 GIS for Terrain Analysis"]}],["$","p",null,{"children":[["$","strong",null,{"children":"Academic focus:"}]," Spatial data analysis and programming for environmental, terrain, and urban applications."]}]]}],["$","article",null,{"className":"education-entry","children":[["$","p",null,{"className":"education-date","children":"June 2022 – December 2025"}],["$","h4",null,{"children":"Florida International University"}],["$","p",null,{"className":"education-degree","children":"Coursework in Crime Science"}],["$","p",null,{"children":"Minor in Political Science"}],["$","p",null,{"children":"GPA: 3.5"}]]}]]}]]}]]}]

f:["$","article",null,{"id":"terrain","className":"terrain-project","aria-labelledby":"terrain-title","children":[["$","div",null,{"className":"terrain-summary","children":[["$","div",null,{"className":"eyebrow","children":"01 / GIS ANALYSIS · COMPLETE PROFESSIONAL STORY"}],["$","h3",null,{"id":"terrain-title","children":"Knoxville’s Urban Growth Based on Terrain"}],["$","p",null,{"className":"project-lead","children":"Using terrain and access to investigate housing suitability."}],["$","p",null,{"children":"An individual project completed in Spring 2026 for GEOG 454 GIS for Terrain Analysis at the University of Tennessee, Knoxville. I combined physical conditions and planning factors in ArcGIS Pro, then explained the analysis in an ArcGIS StoryMap."}],["$","div",null,{"className":"tags","children":[["$","span",null,{"children":"ArcGIS Pro"}],["$","span",null,{"children":"Terrain analysis"}],["$","span",null,{"children":"Suitability modeling"}],["$","span",null,{"children":"StoryMaps"}]]}],["$","p",null,{"className":"project-note","children":[["$","strong",null,{"children":"Evidence:"}]," A personally hosted export of the final suitability map appears below, with an accessible description and source notes. Next, I plan to add a workflow excerpt showing the factor scores and weighting decisions."]}]]}],["$","div",null,{"className":"professional-story","children":[["$","section",null,{"aria-labelledby":"terrain-context","children":[["$","h4",null,{"id":"terrain-context","children":"Context and purpose"}],["$","p",null,{"children":"Knoxville’s terrain creates both opportunities and constraints for housing growth. For my Spring 2026 terrain-analysis project, I investigated how slope, access to roads and existing development, environmental constraints, land cover, and zoning could be combined to identify relatively suitable areas. My goal was to build a transparent spatial model and communicate what it could tell a planning audience."}]]}],["$","section",null,{"aria-labelledby":"terrain-role","children":[["$","h4",null,{"id":"terrain-role","children":"My role"}],["$","p",null,{"children":"This was an individual project. I carried out the GIS analysis, developed the maps, and organized the results into the StoryMap. The underlying elevation, roads, buildings, flood-zone, land-cover, boundary, and zoning datasets came from the agencies and organizations credited with the evidence."}]]}],["$","section",null,{"aria-labelledby":"terrain-methods","children":[["$","h4",null,{"id":"terrain-methods","children":"Methods and tools"}],["$","p",null,{"children":"I used ArcGIS Pro to put datasets into a shared coordinate system and clip them to the study area. I derived slope from a digital elevation model and calculated distance to roads, water, and buildings. I reclassified the factors onto a common 1–5 suitability scale and combined them using weighted overlay."}],["$","p",null,{"children":"Slope received the greatest emphasis, with road access and proximity to existing development also important. Gentle slopes of 0–5 degrees received high suitability. I used ArcGIS StoryMaps to connect the method to maps of terrain, accessibility, environmental constraints, and the final housing-suitability surface."}]]}],["$","section",null,{"aria-labelledby":"terrain-results","children":[["$","h4",null,{"id":"terrain-results","children":"Results and limits"}],["$","p",null,{"children":"I produced a set of four web maps and a published StoryMap explaining the analysis. The model indicates stronger suitability where gentle terrain, road access, existing development, suitable land cover and zoning, and fewer environmental constraints coincide."}],["$","p",null,{"children":"These results describe relative suitability under the model’s assumptions. They do not predict which parcels will be developed. Ownership, property values, utility capacity, developer interest, housing demand, and future zoning decisions would require further investigation before making a real planning decision."}]]}],"$L15"]}],"$L16"]}]
10:["$","article",null,{"id":"church-atlas-project","className":"church-feature","aria-labelledby":"church-title","children":[["$","div",null,{"children":[["$","div",null,{"className":"eyebrow","children":"02 / WEB GIS · APPLICATION PROTOTYPE"}],["$","h3",null,{"id":"church-title","children":"Church Atlas"}],["$","p",null,{"children":"Church Atlas combines an interactive map with structured filters to help visitors explore sample church listings. Users can search an area, adjust a geographic radius, filter by denomination and visit needs, compare profiles, and save favorites and a visit plan in their browser."}],["$","div",null,{"className":"tags","children":[["$","span",null,{"children":"JavaScript"}],["$","span",null,{"children":"Leaflet"}],["$","span",null,{"children":"Web GIS"}],["$","span",null,{"children":"Interface design"}]]}],["$","p",null,{"className":"project-note","children":[["$","strong",null,{"children":"Skills:"}]," Geographic filtering, organizing categorical data, and building an interactive map interface."]}],["$","p",null,{"className":"project-note","children":[["$","strong",null,{"children":"Evidence plan:"}]," The working prototype is linked here and stored in my personal GitHub repository. I plan to add an annotated screenshot and a short code excerpt explaining the distance and filtering logic."]}]]}],["$","div",null,{"className":"church-action","children":[["$","a",null,{"className":"primary-link","href":"/church-atlas/","children":["Open app demo ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":19}]]}],["$","p",null,{"children":"Sample listings and illustrative source-status labels. Leaflet map; © OpenStreetMap contributors. Favorites and visit plans are stored locally in the browser."}]]}]]}]
11:["$","article",null,{"id":"jobfinder-project","className":"featured","aria-labelledby":"jobfinder-title","children":[["$","div",null,{"className":"feature-copy","children":[["$","div",null,{"className":"eyebrow","children":"03 / PYTHON · APPLICATION PROTOTYPE"}],["$","h3",null,{"id":"jobfinder-title","children":["JobFinder",["$","span",null,{"className":"title-dot","children":"."}]]}],["$","p",null,{"className":"lead","children":"The job search, with location in focus."}],["$","p",null,{"children":"A Python and Streamlit prototype for exploring jobs on a map, narrowing results with filters, and comparing opportunities with commute and job-fit information."}],["$","div",null,{"className":"tags","children":[["$","span",null,{"children":"Python"}],["$","span",null,{"children":"Streamlit"}],["$","span",null,{"children":"GIS"}]]}],["$","p",null,{"className":"project-note","children":[["$","strong",null,{"children":"Skills:"}]," Python application development, location-based information design, and turning search criteria into an interactive workflow."]}],["$","p",null,{"className":"project-note","children":[["$","strong",null,{"children":"Evidence plan:"}]," The linked demo shows the intended user experience. I plan to add a personally stored screenshot of the map and filters plus a focused code excerpt so the evidence remains available if the demo is asleep."]}],["$","a",null,{"className":"primary-link","href":"https://colejorgensen28-jobfinder-mvp-streamlit-app-y5bg8r.streamlit.app/","target":"_blank","rel":"noreferrer","children":["Open app demo ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$10:props:children:1:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":19}]]}],["$","p",null,{"className":"demo-note","children":"Prototype with demonstration data. Opens on Streamlit; the free demo may need to wake after inactivity."}]]}],["$","div",null,{"className":"feature-index","aria-label":"JobFinder features","children":[["$
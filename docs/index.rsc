1:[["$","a",null,{"className":"skip-link","href":"#main","children":"Skip to main content"}],["$","header",null,{"className":"header wrap","children":[["$","a",null,{"href":"#home","className":"identity","aria-label":"Cole Jorgensen home","children":[["$","span",null,{"className":"monogram","children":["CJ",["$","span",null,{"children":"↗"}]]}],["$","span",null,{"children":"Cole Jorgensen"}]]}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"#home","children":"Home"}],["$","a",null,{"href":"#about","children":"About"}],["$","a",null,{"href":"#work","children":"Projects"}],["$","a",null,{"href":"#connect","children":"Connect"}]]}]]}],["$","main",null,{"id":"main","children":[["$","section",null,{"id":"home","className":"intro wrap","aria-labelledby":"intro-title","children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{"className":"dot"}]," GIS · APPLICATIONS · STORYTELLING"]}],["$","h1",null,{"id":"intro-title","children":["A sense of place.",["$","br",null,{}],["$","span",null,{"children":"A world of possibility."}]]}],["$","div",null,{"className":"intro-bottom","children":[["$","p",null,{"children":"I’m Cole Jorgensen. I use maps, data, and software to explore places and build useful tools."}],["$","a",null,{"className":"work-link","href":"#work","children":["Explore my work ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v14","key":"s699le"}],["path",{"d":"m19 12-7 7-7-7","key":"1idqje"}]],"className":"lucide-arrow-down","size":20}]]}]]}]]}],["$","section",null,{"id":"about","className":"about wrap","aria-labelledby":"about-title","children":[["$","div",null,{"className":"about-photo","children":["$","img",null,{"src":"/images/cole-jorgensen.jpeg","alt":"Cole Jorgensen wearing a dark suit and tie","width":3024,"height":4032,"loading":"lazy"}]}],["$","div",null,{"className":"about-copy","children":[["$","div",null,{"className":"eyebrow","children":"BEHIND THE PROJECTS"}],["$","h2",null,{"id":"about-title","children":"About me"}],["$","p",null,{"className":"about-lead","children":"I bring maps, data, and application development together to explore how people connect with places."}],["$","p",null,{"children":"My work spans GIS analysis, interactive storytelling, and practical web applications. Through terrain analysis, Church Atlas, and JobFinder, I explore how location can support planning and help people find communities and opportunities."}],["$","p",null,{"children":"I’m interested in GIS analysis and web mapping roles where I can turn spatial data into clear explanations and useful tools. This portfolio is intended for GIS employers, internship supervisors, and professionals working in planning and spatial application development."}],["$","div",null,{"className":"tags","children":[["$","span",null,{"children":"Geographic information systems"}],["$","span",null,{"children":"Web applications"}],["$","span",null,{"children":"Interactive storytelling"}]]}]]}],["$","div",null,{"className":"education","aria-labelledby":"education-title","children":[["$","h3",null,{"id":"education-title","children":"Education"}],["$","div",null,{"className":"education-grid","children":[["$","article",null,{"className":"education-entry","children":[["$","p",null,{"className":"education-date","children":"Expected May 2027"}],["$","h4",null,{"children":"University of Tennessee, Knoxville"}],["$","p",null,{"className":"education-degree","children":"Bachelor of Science in Geographic Information Science and Technology"}],["$","p",null,{"children":[["$","strong",null,{"children":"Relevant coursework:"}]," GEOG 312 GIS Programming; GEOG 454 GIS for Terrain Analysis"]}],["$","p",null,{"children":[["$","strong",null,{"children":"Academic focus:"}]," Spatial data analysis and programming for environmental, terrain, and urban applications."]}]]}],["$","article",null,{"className":"education-entry","children":[["$","p",null,{"className":"education-date","children":"June 2022 – December 2025"}],["$","h4",null,{"children":"Florida International University"}],["$","p",null,{"className":"education-degree","children":"Coursework in Crime Science"}],["$","p",null,{"children":"Minor in Political Science"}],["$","p",null,{"children":"GPA: 3.5"}]]}]]}]]}]]}],["$","section",null,{"id":"work","className":"work wrap","aria-labelledby":"work-title","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"work-title","children":"Projects"}],"$Le"]}],"$Lf","$L10","$L11","$L12"]}],"$L13"]}],"$L14"]

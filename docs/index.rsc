15:["$","section",null,{"aria-labelledby":"terrain-reflection","children":[["$","h4",null,{"id":"terrain-reflection","children":"Reflection"}],["$","p",null,{"children":"The main lesson I take from this project is that a suitability map reflects decisions about factors, scores, and weights. Explaining those decisions is part of making the analysis useful. This experience connects my interest in GIS with planning questions and clear public communication. My next step would be to compare alternative weights and document how sensitive the results are to those choices."}]]}]
16:["$","figure",null,{"className":"terrain-evidence","aria-labelledby":"terrain-evidence-title","children":[["$","h4",null,{"id":"terrain-evidence-title","children":"Evidence · Final housing suitability map"}],["$","p",null,{"children":"This static export preserves the final model as evidence on my personal portfolio. It can be viewed here without signing into ArcGIS."}],["$","a",null,{"href":"/evidence/knoxville-housing-suitability.png","target":"_blank","rel":"noreferrer","aria-label":"Open the full-resolution Knoxville housing suitability map","children":["$","img",null,{"src":"/evidence/knoxville-housing-suitability.png","alt":"Knoxville housing suitability model with roads and the city boundary. Green indicates higher relative suitability and red lower suitability. A detailed text description follows.","width":2400,"height":1500,"loading":"lazy"}]}],["$","div",null,{"className":"map-legend","aria-label":"Relative modeled suitability, lower to higher","children":[["$","span",null,{"children":"Lower suitability"}],["$","span",null,{"className":"legend-ramp","aria-hidden":"true"}],["$","span",null,{"children":"Higher suitability"}]]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Knoxville housing suitability — final model."}]," Analysis and map by Cole Jorgensen, Spring 2026. This is a static rendering of my final web map, showing the modeled suitability layer, roads, and city boundary. It documents a course analysis and should be read with the limitations above."]}],["$","details",null,{"className":"evidence-description","children":[["$","summary",null,{"children":"Map description and source credits"}],["$","p",null,{"children":"The map shows the irregular Knoxville city boundary in black with a network of gray roads. Most of the displayed modeled area is green, with lower-suitability red areas in narrower patches, including along parts of the river corridor. The red-to-yellow-to-green ramp represents lower to higher modeled suitability; it is a continuous display, not a parcel approval or a forecast. White areas have no suitability surface shown in this export. The description provides a text equivalent without relying only on color."}],["$","p",null,{"children":["Project data sources credited in the original StoryMap: USGS 3DEP elevation; U.S. Census Bureau TIGER/Line roads and water; Microsoft Building Footprints; FEMA flood zones; Esri/USGS National Land Cover Database; City of Knoxville boundary; Knoxville–Knox County Planning zoning; and KGIS. Static rendering produced through Esri’s public map-printing service. ",["$","a",null,{"href":"/evidence/terrain-evidence-notes.txt","children":"Read the evidence and attribution notes"}],"."]}]]}],["$","div",null,{"className":"evidence-links","children":[["$","a",null,{"className":"text-link","href":"/evidence/knoxville-housing-suitability.png","download":true,"children":["Download map evidence ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:2:props:children:0:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-down","size":17}]]}],["$","a",null,{"className":"text-link","href":"https://storymaps.arcgis.com/stories/38c29a40909d4fcd8070e5e6805f54a2","target":"_blank","rel":"noreferrer","children":["Read the original StoryMap ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$10:props:children:1:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":17}]]}]]}],["$","p",null,{"className":"project-note","children":"The original interactive StoryMap is hosted through UTK ArcGIS. The map image and explanation on this page are stored separately in my personal GitHub repository."}]]}]
